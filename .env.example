# Copy to .env and set the model Cerebro uses. pnpm start writes these values
# into runtime.json on every start. Any OpenAI-compatible endpoint works.

# provider/model. The part after the first slash is sent to the endpoint.
CEREBRO_MODEL=openai/gpt-4.1-mini
CEREBRO_MODEL_BASE_URL=https://api.openai.com/v1
CEREBRO_MODEL_API_KEY=<API_KEY>

# A model on this machine, for example Ollama:
# CEREBRO_MODEL=ollama/llama3.2
# CEREBRO_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# CEREBRO_MODEL_API_KEY=
