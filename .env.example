# Copy this file to .env. pnpm start writes the model into runtime.json.

# The default model is GPT-6 Luna on OpenRouter. Create a key at
# https://openrouter.ai/keys and paste it here. Never commit .env.
CEREBRO_MODEL_API_KEY=<OPENROUTER_API_KEY>

# To use another OpenRouter model, set its ID after "openrouter/":
# CEREBRO_MODEL=openrouter/openai/gpt-6-sol

# To use another OpenAI-compatible endpoint, set all three. For a model on
# your machine, such as Ollama, leave the key empty:
# CEREBRO_MODEL=ollama/qwen3:8b
# CEREBRO_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# CEREBRO_MODEL_API_KEY=
