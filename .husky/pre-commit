#!/bin/sh

STAGED_FILES_FILE=$(mktemp)
trap 'rm -f "$STAGED_FILES_FILE"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$STAGED_FILES_FILE"

if [ ! -s "$STAGED_FILES_FILE" ]; then
  exit 0
fi

xargs -0 pnpm exec ultracite fix < "$STAGED_FILES_FILE" || exit $?
xargs -0 git add -- < "$STAGED_FILES_FILE"
