    "@cerebro/tools": "workspace:*",
    "@earendil-works/pi-ai": "1.1.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "agents": "0.26.0",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
