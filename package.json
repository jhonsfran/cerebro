{
  "name": "cerebro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "node deploy/local.mjs start",
    "stop": "node deploy/local.mjs stop",
    "token": "node deploy/local.mjs token",
    "logs": "node deploy/local.mjs logs",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "db:generate": "turbo run db:generate -F @cerebro/db --",
    "test:contracts": "node --test tests/contracts/*.test.ts",
    "test:chat": "node --test tests/live/chat-stream.test.ts",
    "test:boot": "node --test tests/integration/boot.test.ts",
    "test:runtime": "node --test --test-concurrency=1 tests/runtime/*.test.ts && bun test tests/runtime/content-dependencies.test.mjs",
    "test:identity": "bun test tests/identity/*.test.ts",
    "test:identity:postgres": "bun test tests/identity/postgres/*.test.ts",
    "test:policy": "node tests/policy/run.mjs",
    "test:memory": "node tests/memory/run.mjs",
    "test:channels": "node tests/channels/run.mjs",
    "test:integration": "node --test tests/integration/*.test.ts",
    "check": "ultracite check",
    "check:react": "react-doctor . --yes --project web,@cerebro/ui --blocking error --no-score --no-supply-chain",
    "verify:commit": "sh .husky/pre-commit",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test:channels:native": "node tests/channels/native/run.mjs",
    "test:pi:live": "node --test tests/live/pi.test.ts"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "drizzle-orm": "catalog:",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cerebro/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "catalog:",
    "effect": "4.0.1",
    "esbuild": "0.28.2",
    "husky": "latest",
    "oxfmt": "0.71.0",
    "oxlint": "1.87.0",
    "react-doctor": "0.9.17",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@11.9.0"
}
