{
  "name": "cerebro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:generate": "turbo run db:generate -F @cerebro/db --",
    "deploy": "docker compose build bootstrap && docker compose run --rm bootstrap",
    "test:contracts": "node --test tests/contracts/contracts.test.ts",
    "test:opencode": "node --test tests/live/opencode.test.ts",
    "test:chat": "node --test tests/live/chat-stream.test.ts",
    "test:boot": "node --test tests/integration/boot.test.ts",
    "test:runtime": "node --test tests/runtime/*.test.ts",
    "test:identity": "bun test tests/identity/*.test.ts",
    "test:identity:postgres": "bun test tests/identity/postgres/*.test.ts",
    "test:policy": "node tests/policy/run.mjs",
    "test:memory": "node tests/memory/run.mjs",
    "test:channels": "node tests/channels/run.mjs",
    "test:integration": "node --test tests/integration/*.test.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test:channels:native": "node tests/channels/native/run.mjs",
    "test:policy:runtime": "node --test tests/policy/runtime/*.test.ts"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "drizzle-orm": "catalog:",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cerebro/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "husky": "latest",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@11.9.0"
}
