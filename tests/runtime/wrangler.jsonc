{
  "name": "cerebro-runtime-test",
  "main": "tests/runtime/worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DATABASE_URL": "postgres://runtime:runtime-local-only@postgres:5432/runtime",
    "FIXTURE_URL": "http://fixture:8090",
    "FAIL_FIRST_EFFECT": "0",
    "TRACE_NATIVE": "0",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionAgent" },
      { "name": "STORAGE_CONFORMANCE", "class_name": "StorageConformance" },
      { "name": "TEAM", "class_name": "TeamFixture" },
      { "name": "COORDINATOR", "class_name": "CoordinatorFixture" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["StorageConformance"] },
    { "tag": "v3", "new_sqlite_classes": ["TeamFixture"] },
    { "tag": "v4", "new_sqlite_classes": ["CoordinatorFixture"] },
  ],
  "services": [
    {
      "binding": "AUDIT_SINK",
      "service": "cerebro-runtime-test",
      "entrypoint": "AuditSink",
    },
  ],
}
