{
  "name": "cerebro-runtime-test",
  "main": "tests/runtime/worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DATABASE_URL": "postgres://runtime:runtime-local-only@postgres:5432/runtime",
    "FIXTURE_URL": "http://fixture:8090",
    "FAIL_FIRST_EFFECT": "0",
    "TRACE_NATIVE": "0",
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionAgent"] }],
  "services": [
    {
      "binding": "TOOL_GATEWAY",
      "service": "cerebro-runtime-test",
      "entrypoint": "FixtureEffectGateway",
    },
    {
      "binding": "AUDIT_SINK",
      "service": "cerebro-runtime-test",
      "entrypoint": "AuditSink",
    },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
}
